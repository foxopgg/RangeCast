# ============================================================
# RangeCast Environment Configuration (.env.example)
# Copy to .env and fill in real values before running.
# NEVER commit .env to source control.
# ============================================================

# ---- Groq AI Configuration --------------------------------
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use. Must be available on your Groq account.
# Recommended: llama-3.3-70b-versatile  |  mixtral-8x7b-32768  |  gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# ---- FastAPI Server Settings ------------------------------
HOST=0.0.0.0
PORT=8000
# Set to "production" to disable debug mode
APP_ENV=development

# ---- Rate Limiting ----------------------------------------
# Max requests per minute per client IP to /api/ask and /api/summary
GROQ_RATE_LIMIT_RPM=10

# ---- Groq Timeout (seconds) --------------------------------
GROQ_TIMEOUT_SECONDS=8
